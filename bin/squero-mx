#!/usr/bin/env node
// squero-mx — the native launcher: serve dist/, the default workspace, and the Julia kernel.
// `paperboat start squero-studio-mx` runs this. `--port`, `--open`, `--workspace`.
import { createReadStream, existsSync, mkdirSync, statSync } from "node:fs";
import { createServer } from "node:http";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { spawn } from "node:child_process";
import { DEFAULT_WORKSPACE, shortRoot, workspaceMiddleware } from "../server/workspace.mjs";
import { attachKernel, kernelRuntime, KERNEL_IMAGE } from "../server/kernel.mjs";
import { optimizeMiddleware } from "../server/optimize.mjs";
import { juliaMiddleware } from "../server/julia.mjs";
import { configMiddleware } from "../server/config.mjs";
import { backendsMiddleware } from "../server/backends.mjs";

const here = path.dirname(fileURLToPath(import.meta.url));
const dist = path.resolve(here, "../dist");

// `--name=value` or `--name value` (paperboat passes the second form).
const arg = (name, fallback) => {
  const at = process.argv.findIndex((value) => value === `--${name}` || value.startsWith(`--${name}=`));
  if (at < 0) return fallback;
  const hit = process.argv[at];
  if (hit.includes("=")) return hit.slice(hit.indexOf("=") + 1);
  const next = process.argv[at + 1];
  return next !== undefined && !next.startsWith("--") ? next : "";
};

const workspace = path.resolve(arg("workspace", process.env.MX_WORKSPACE ?? DEFAULT_WORKSPACE));
mkdirSync(workspace, { recursive: true });
const open = process.argv.includes("--open");
const start = Number(arg("port", process.env.PORT ?? 59202));

if (!existsSync(path.join(dist, "index.html"))) {
  console.error("squero-mx: dist/ is missing — run `npm run build` first.");
  process.exit(2);
}

const MIME = {
  ".html": "text/html; charset=utf-8",
  ".js": "text/javascript; charset=utf-8",
  ".mjs": "text/javascript; charset=utf-8",
  ".css": "text/css; charset=utf-8",
  ".json": "application/json; charset=utf-8",
  ".svg": "image/svg+xml",
  ".png": "image/png",
  ".jpg": "image/jpeg",
  ".jpeg": "image/jpeg",
  ".webp": "image/webp",
  ".woff2": "font/woff2",
  ".woff": "font/woff",
  ".ico": "image/x-icon",
  ".wasm": "application/wasm",
  ".map": "application/json; charset=utf-8",
};

const workspaceApi = workspaceMiddleware(workspace);
const optimizeApi = optimizeMiddleware();
const juliaApi = juliaMiddleware({ workspace });
const backendsApi = backendsMiddleware();
const configApi = configMiddleware();
const server = createServer((req, res) => {
  const url = new URL(req.url ?? "/", "http://localhost");
  if (url.pathname === "/__mx/optimize") {
    void optimizeApi(req, res, () => { res.statusCode = 404; res.end(); });
    return;
  }
  if (url.pathname.startsWith("/__mx/julia")) {
    void juliaApi(req, res, () => { res.statusCode = 404; res.end(); });
    return;
  }
  if (url.pathname === "/__mx/config") {
    void configApi(req, res);
    return;
  }
  if (url.pathname.startsWith("/__mx/backends")) {
    backendsApi(req, res, () => { res.statusCode = 404; res.end(); });
    return;
  }
  if (url.pathname.startsWith("/__mx/workspace")) {
    void workspaceApi(req, res, () => { res.statusCode = 404; res.end(); });
    return;
  }
  const relative = decodeURIComponent(url.pathname);
  const safe = path.normalize(relative).replace(/^(\.\.[/\\])+/, "");
  let file = path.join(dist, safe);
  if (!file.startsWith(dist) || !existsSync(file) || !statSync(file).isFile()) file = path.join(dist, "index.html");
  res.setHeader("content-type", MIME[path.extname(file)] ?? "application/octet-stream");
  res.setHeader("cache-control", file.endsWith("index.html") ? "no-cache" : "public, max-age=31536000, immutable");
  createReadStream(file).pipe(res);
});

const kernel = attachKernel(server, { workspace });

const listen = (port, left = 100) => {
  server.once("error", (error) => {
    if (error.code === "EADDRINUSE" && left > 0) {
      server.close(() => listen(port + 1, left - 1));
    } else {
      console.error(`squero-mx: ${error.message}`);
      process.exit(1);
    }
  });
  server.listen(port, "127.0.0.1", () => {
    const url = `http://127.0.0.1:${port}`;
    console.log("squero studio MX");
    console.log(`  url     ${url}`);
    console.log(`  folder  ${shortRoot(workspace)}`);
    console.log(`  kernel  ${KERNEL_IMAGE} (${kernelRuntime()})`);
    if (open) {
      const [cmd, args] =
        process.platform === "win32" ? ["cmd", ["/c", "start", "", url]]
        : process.platform === "darwin" ? ["open", [url]]
        : ["xdg-open", [url]];
      spawn(cmd, args, { stdio: "ignore", detached: true, windowsHide: true }).unref();
    }
  });
};

listen(start);

const stop = () => {
  kernel.close();
  server.close(() => process.exit(0));
  setTimeout(() => process.exit(0), 500).unref();
};
process.on("SIGINT", stop);
process.on("SIGTERM", stop);
